# kgsm-web-static — where this machine serves the Control Panel as a static site.
#
# The public DNS name the panel answers at, pointing at this machine, with ports 80 and 443 reaching it.
# Blank serves nothing. After changing it:  systemctl restart kgsm-web-static
KGSM_PANEL_HOST=

# The address Let's Encrypt writes to about the certificate. Used only when this machine has no ACME
# account yet; without it the account is registered with no address.
#KGSM_PANEL_ACME_EMAIL=
