# Maintainer: Cristian Moraru <info@thekrystalship.com>
#
# Build from this directory:  cd packaging && makepkg
#
# Two built bundles of static files from one checkout, as two packages. Nothing here executes on the
# host.
#
#   kgsm-web       the Control Panel, served by kgsm-api same-origin, so the panel and the API it
#                  talks to are one address.
#   kgsm-web-auth  the auth anchor's own pages — sign-in, registration, the wait for approval and the
#                  account page — which kgsm-auth-anchor serves at /ui/ from /usr/share/kgsm-web-auth,
#                  the path it reads by default.
#
# Each is its own package rather than part of the daemon serving it, so a page upgrades without
# rebuilding the daemon, each repo's version means what it says, and a host can run either daemon
# without its pages by simply not installing them.

pkgbase=kgsm-web
pkgname=('kgsm-web' 'kgsm-web-auth')
# A placeholder: pkgver() below replaces it with what deploy/version.sh reports, so the number is
# declared in exactly one place and this file never carries a copy that can fall behind.
pkgver=1.230.0
pkgrel=1
pkgdesc="KGSM web surfaces"
arch=('any')
url="https://github.com/TheKrystalShip/kgsm-web"
license=('GPL-3.0-or-later')
# No separate debug package: these are shipped to a private fleet, not a distro archive.
options=('!debug')

_stage() { printf '%s' "${KGSM_STAGE:-${startdir}/..}"; }

pkgver() {
    "${startdir}/../deploy/version.sh" --pkgver
}

build() {
    local stage; stage="$(_stage)"
    [[ -f "${stage}/dist/index.html" && -f "${stage}/dist-auth/auth-sign-in.html" ]] || {
        printf '\n  no built bundles under %s\n' "$stage" >&2
        printf '  build them first:  VITE_API_BASE=self npm run build && npm run build:auth\n' >&2
        printf '  or point KGSM_STAGE at a directory holding dist/ and dist-auth/.\n\n' >&2
        return 1
    }
}

# Copy a built tree into the package with the modes a static file tree wants, whatever the build left.
_install_tree() {
    local from="$1" to="$2"
    install -dm755 "$to"
    cp -a "${from}/." "${to}/"
    find "$to" -type f -exec chmod 0644 {} +
    find "$to" -type d -exec chmod 0755 {} +
}

package_kgsm-web() {
    pkgdesc="KGSM Control Panel — the web UI served by kgsm-api"
    groups=('kgsm-node')
    depends=()
    optdepends=('kgsm-api: serves this bundle and answers every call it makes')

    # VITE_API_BASE=self is what makes the bundle talk to whatever origin served it, so one build
    # works on every host and no domain is baked in.
    _install_tree "$(_stage)/dist" "${pkgdir}/usr/share/kgsm-web"

    # Point kgsm-api's web root at this bundle. ASPNETCORE_WEBROOT is the standard host-configuration
    # key behind IWebHostEnvironment.WebRootPath, which is what the API's same-origin SPA delivery
    # gates on and serves from — so the panel is reached with no code in the API naming this path.
    #
    # The drop-in belongs to THIS package: it is only ever correct while these files exist. ASP.NET
    # creates a missing web root at startup, which the service user could not do under /usr/share, so
    # a drop-in outliving the bundle would take the API down rather than merely serve no panel.
    install -Dm644 /dev/stdin \
        "${pkgdir}/usr/lib/systemd/system/kgsm-api.service.d/50-kgsm-web.conf" <<DROPIN
[Service]
Environment=ASPNETCORE_WEBROOT=/usr/share/kgsm-web
DROPIN

    install -Dm644 "${startdir}/../LICENSE" "${pkgdir}/usr/share/licenses/kgsm-web/LICENSE"
}

package_kgsm-web-auth() {
    pkgdesc="KGSM sign-in pages — the auth anchor's sign-in, registration and account pages"
    groups=('kgsm-node')
    depends=()
    optdepends=('kgsm-auth-anchor: serves these pages at /ui/')

    # At the anchor's default Anchor__UiPath, so installing this needs no configuration and no
    # restart: the anchor reads the documents from disk on every request.
    _install_tree "$(_stage)/dist-auth" "${pkgdir}/usr/share/kgsm-web-auth"

    install -Dm644 "${startdir}/../LICENSE" "${pkgdir}/usr/share/licenses/kgsm-web-auth/LICENSE"
}
